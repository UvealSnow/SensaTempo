FROM node:22-alpine AS build

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
# Build preview as a "server" output (PUBLIC_BUILD_TYPE controls Astro output)
ENV PUBLIC_BUILD_TYPE=server
RUN pnpm build

# SPA-style hosting on S3/CloudFront usually needs fallback-to-index behavior
# for deep links. A common pattern is using 404.html as index fallback.
RUN cp dist/index.html dist/404.html

FROM nginx:1.27-alpine AS preview

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

RUN adduser -D -H -u 1001 appuser && \
  chown -R appuser:appuser /usr/share/nginx/html

USER appuser

CMD ["nginx", "-g", "daemon off;"]
