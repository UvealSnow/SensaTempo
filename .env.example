NODE_ENV="development"

# Published-only token: production (static) builds
STORYBLOK_PUBLIC_TOKEN=<YOUR_TOKEN_HERE>

# Preview token (drafts): `pnpm dev` and the SSR preview (PUBLIC_BUILD_TYPE=server)
STORYBLOK_PREVIEW_TOKEN=<YOUR_TOKEN_HERE>

PUBLIC_DEFAULT_LANGUAGE=es
PUBLIC_AVAILABLE_LANGUAGES=es,en

# Cloudflare Web Analytics site token (public). Leave empty locally; CI sets it for production only
PUBLIC_CF_ANALYTICS_TOKEN=

# Cloudflare Turnstile site key (public), for the contact form. Empty = Cloudflare's always-pass test key
PUBLIC_TURNSTILE_SITE_KEY=

# This deploy's public origin (canonical URLs, og:url, sitemap). Default: https://sensatempo.com
PUBLIC_SITE_URL=
# "true" lets search engines index this deploy (never the preview). Default: noindex
PUBLIC_ALLOW_INDEXING=
