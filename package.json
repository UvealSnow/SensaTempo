{
  "name": "sensatempo",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:preview:build": "make build-preview",
    "docker:preview:run": "make run-preview",
    "docker:prod:build": "make build-prod",
    "docker:prod:preview": "make run-prod-preview",
    "docker:cleanup": "make clean",
    "tf:init": "terraform -chdir=./terraform init",
    "tf:plan": "terraform -chdir=./terraform plan",
    "tf:apply": "terraform -chdir=./terraform apply"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@storyblok/astro": "^7.3.9",
    "@storyblok/js": "^4.4.5",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "sass-embedded": "^1.98.0"
  }
}