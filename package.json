{
  "name": "sensatempo",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "docker:prod:build": "make build-prod",
    "docker:prod:preview": "make run-prod-preview",
    "docker:cleanup": "make clean",
    "preview:local": "make run-preview",
    "preview:package": "make package-preview",
    "preview:deploy": "make deploy-preview",
    "tf:init": "terraform -chdir=./terraform init",
    "tf:plan": "terraform -chdir=./terraform plan",
    "tf:apply": "terraform -chdir=./terraform apply",
    "tf:destroy": "terraform -chdir=./terraform destroy"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@storyblok/astro": "^10.3.2",
    "@storyblok/js": "^6.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sass-embedded": "^1.105.1"
  }
}
