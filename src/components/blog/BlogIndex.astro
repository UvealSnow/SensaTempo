---
import { storyblokEditable, type SbBlokData } from '@storyblok/astro';
import Picture from '~/components/Picture.astro';
import { socialLinks } from '~/utils/blog';
import { responsiveImage, type StoryblokAsset } from '~/utils/images';
import type { PostSummary } from '~/utils/posts';
import type { Blog } from '~/utils/stories';
import BlogSidebar from './BlogSidebar.astro';
import Paginator from './Paginator.astro';
import SocialIcon from './SocialIcon.astro';
import PostCard from './PostCard.astro';

interface Props {
  title: string;
  description?: string;
  posts: PostSummary[];
  page: number;
  totalPages: number;
  basePath: string;
  lang: string;
  blog: Blog;
  month?: { year: number; month: number };
  // Author pages
  photo?: StoryblokAsset;
  socials?: { icon?: string; url?: string }[];
  blok?: SbBlokData | null;
}

const {
  title,
  description,
  posts,
  page,
  totalPages,
  basePath,
  lang,
  blog,
  month,
  photo,
  socials,
  blok,
} = Astro.props;
const { strings } = blog;
const image = responsiveImage(photo, {
  ratio: 'square',
  spans: { md: '1/12', lg: '1/12' },
});
const links = socialLinks(socials);
---

<div class="flex flex-col gap-16 lg:gap-20">
  <header
    class="flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8"
    {...(blok ? storyblokEditable(blok) : {})}
  >
    {image && (
      <Picture
        image={image}
        eager
        class="size-24 shrink-0 overflow-hidden rounded-full md:size-32"
      />
    )}
    <div class="flex flex-col gap-6">
      <h1 class="font-display text-dark-gray text-4xl leading-tight md:text-[40px]">
        {title}
      </h1>
      {description && (
        <p class="font-body text-light-gray max-w-[600px] text-xl leading-8">
          {description}
        </p>
      )}
      {links.length > 0 && (
        <ul class="flex flex-wrap gap-3">
          {links.map(({ icon, href, label }) => (
            <li>
              <a
                href={href}
                aria-label={label}
                title={label}
                rel="me"
                class="border-line text-dark-gray hover:bg-chip focus-visible:outline-dark-gray flex size-10 items-center justify-center rounded-full border focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                <SocialIcon icon={icon} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </header>

  <div class="grid grid-cols-1 gap-16 lg:grid-cols-[1fr_320px]">
    <div class="min-w-0">
      {posts.length === 0 && (
        <p class="font-body text-light-gray text-xl">{strings.empty_label}</p>
      )}
      <ul class="flex flex-col gap-12">
        {posts.map((post, i) => (
          <li>
            <PostCard post={post} strings={strings} eager={i === 0} />
          </li>
        ))}
      </ul>
      <Paginator
        page={page}
        totalPages={totalPages}
        basePath={basePath}
        strings={strings}
      />
    </div>
    <BlogSidebar lang={lang} blog={blog} month={month} />
  </div>
</div>
