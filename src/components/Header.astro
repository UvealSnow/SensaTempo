---
import {
  getColSpans,
  getColStarts,
  getVerticalAlignment,
  type FlexSize,
  type FlexStart,
  type VerticalAlign,
} from '~/utils/grid';

interface Props {
  src: string;
  size?: FlexSize;
  start?: FlexStart;
  vertical?: VerticalAlign;
  position?: string;
  heightClass?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  size,
  start,
  vertical,
  position = 'center center',
  heightClass = 'h-[320px] sm:h-[420px] md:h-[560px] lg:h-[700px] xl:h-[850px]',
  loading = 'lazy',
  class: className,
} = Astro.props;

const sizeClass =
  getColSpans(size ?? { sm: '12/12' }, 'col-span-12') +
  getColStarts(start ?? {}) +
  ` ${getVerticalAlignment(vertical)}`;
---

<section
  data-sensaheader
  class={`header relative overflow-hidden ${heightClass} ${sizeClass} ${className ?? ''}`.trim()}
>
  <div
    class="header__bg absolute inset-0 bg-cover bg-no-repeat blur-[18px] scale-[1.03] opacity-65 transition-[filter,transform,opacity] duration-500 ease-in-out"
    style={`background-image: url('${src}'); background-position: ${position};`}
  ></div>

  <img
    src={src}
    alt=""
    aria-hidden="true"
    loading={loading}
    decoding="async"
    class="header__preload pointer-events-none absolute h-px w-px opacity-0"
    onload="const bg = this.closest('[data-sensaheader]')?.querySelector('.header__bg'); bg?.classList.remove('blur-[18px]','scale-[1.03]','opacity-65'); bg?.classList.add('blur-0','scale-100','opacity-100');"
  />

  <div class="relative z-10">
    <slot />
  </div>
</section>
