---
import dayjs from '~/utils/dates';
import { currentLang } from '~/utils/page';

interface Props {
  date: Date;
  format?: string;
  class?: string;
}

const { date, format = 'LL', class: className } = Astro.props;
// UTC: Storyblok dates are UTC days, whatever the build machine's zone
const day = dayjs.utc(date).locale(currentLang(Astro));
---

<time datetime={day.toISOString()} class={className}>
  {day.format(format)}
</time>
