---
import { storyblokEditable, type SbBlokData } from '@storyblok/astro';
import Menu from '~/assets/icons/menu.svg';
import Close from '~/assets/icons/close.svg';
import { AVAILABLE_LANGUAGES, SITE_TITLE } from '~/consts';
import {
  HOME_SLUG,
  pagePath,
  resolveLinks,
  type LinkBlok,
} from '~/utils/navigation';

interface Props {
  lang: string;
  slug: string;
  blok: SbBlokData | null;
}

const { lang, slug, blok } = Astro.props;

const logo = blok?.logo as { filename?: string; alt?: string } | undefined;

const links = resolveLinks(
  blok?.links as (LinkBlok & SbBlokData)[] | undefined,
  lang,
  slug,
  AVAILABLE_LANGUAGES
);
const languages = AVAILABLE_LANGUAGES.filter((other) => other !== lang);
---

<header
  class="px-4 py-6 container mx-auto md:p-8 lg:flex lg:flex-row lg:justify-between xl:px-0"
  {...(blok ? storyblokEditable(blok) : {})}
>
  <div class="relative z-50 flex w-full flex-row justify-between md:block lg:w-auto">
    <a
      href={pagePath(lang, HOME_SLUG)}
      aria-label={logo?.filename ? undefined : SITE_TITLE}
    >
      {logo?.filename ? (
        <img
          src={logo.filename}
          alt={logo.alt || SITE_TITLE}
          class="h-[62px] w-auto"
        />
      ) : (
        <div class="h-[62px] w-[180px] bg-amber-100" />
      )}
    </a>

    <button
      type="button"
      class="cursor-pointer md:hidden"
      data-navbar-toggle
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <Menu data-navbar-icon-open class="block" />
      <Close data-navbar-icon-close class="hidden" />
    </button>
  </div>

  <nav
    data-navbar-links
    class="font-body bg-off-white absolute top-0 left-0 z-40 hidden h-screen w-screen flex-col items-center justify-center gap-8 text-4xl md:relative md:top-auto md:left-auto md:z-auto md:flex md:h-auto md:w-full md:flex-row md:justify-between md:gap-4 md:pt-8 md:text-2xl lg:justify-end lg:gap-8 lg:pt-0"
  >
    {links.map(({ blok: link, label, href, isActive }) => (
      <a
        href={href}
        aria-current={isActive ? 'page' : undefined}
        class="text-gray-700 hover:text-gray-900 aria-[current=page]:text-gray-900 aria-[current=page]:underline md:w-24 md:text-center"
        {...storyblokEditable(link)}
      >
        {label}
      </a>
    ))}

    {languages.map((other) => (
      <a
        href={pagePath(other, slug)}
        hreflang={other}
        lang={other}
        class="text-gray-700 hover:text-gray-900 md:text-center"
      >
        {other.toUpperCase()}
      </a>
    ))}
  </nav>
</header>
