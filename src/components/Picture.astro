---
type FlexSize = { sm?: string; md?: string; lg?: string };
type VerticalAlign = 'start' | 'center' | 'end';

interface Props {
  caption: string;
  size?: FlexSize;
  vertical?: VerticalAlign;
  src: string;
  class?: string;
}

const { caption, size, src, class: className, vertical } = Astro.props;

const sizeMap: Record<string, string> = {
  '1/12': 'col-span-1',
  '2/12': 'col-span-2',
  '3/12': 'col-span-3',
  '4/12': 'col-span-4',
  '5/12': 'col-span-5',
  '6/12': 'col-span-6',
  '7/12': 'col-span-7',
  '8/12': 'col-span-8',
  '9/12': 'col-span-9',
  '10/12': 'col-span-10',
  '11/12': 'col-span-11',
  '12/12': 'col-span-12',
};

const verticalAlignMap: Record<string, string> = {
  start: 'self-start',
  center: 'self-center',
  end: 'self-end',
};

const getColSpans = (sizes: FlexSize): string => {
  let result = '';

  for (const [breakpoint, value] of Object.entries(sizes)) {
    const mapped = sizeMap[value] ?? 'basis-full w-full';
    if (breakpoint === 'sm') {
      result += ` ${mapped}`;
      continue;
    }

    result += ` ${breakpoint}:${mapped.replaceAll(' ', ` ${breakpoint}:`)}`;
  }

  return result;
};

const getVerticalAlignment = (vertical?: VerticalAlign): string => {
  if (!vertical) return verticalAlignMap['start'];
  return verticalAlignMap[vertical] || verticalAlignMap['start'];
};

const sizeClass =
  getColSpans(size ?? {}) + ` ${getVerticalAlignment(vertical)}`;
---

<figure
  class={`relative overflow-hidden ${sizeClass} ${className ?? ''}`.trim()}
>
  <img
    src={src}
    alt={caption}
    loading="lazy"
    decoding="async"
    class="sensapicture__img"
    onload="this.classList.add('is-loaded')"
  />
  <figcaption class="font-body text-gray-500 text-right text-md mt-2">
    {caption}
  </figcaption>

  <style>
    /* Blur-up placeholder: we start blurred and remove blur once the real image has loaded. */
    .sensapicture__img {
      width: 100%;
      display: block;
      object-fit: cover;
      filter: blur(18px);
      transform: scale(1.03);
      opacity: 0.65;
      transition:
        filter 500ms ease,
        transform 500ms ease,
        opacity 500ms ease;
    }

    .sensapicture__img.is-loaded {
      filter: blur(0);
      transform: scale(1);
      opacity: 1;
    }
  </style>
</figure>
