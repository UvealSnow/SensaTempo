---
import {
  getColSpans,
  getColStarts,
  getVerticalAlignment,
  type FlexSize,
  type FlexStart,
  type VerticalAlign,
} from '~/utils/grid';

interface Props {
  caption: string;
  size?: FlexSize;
  start?: FlexStart;
  vertical?: VerticalAlign;
  src: string;
  class?: string;
}

const { caption, size, start, src, class: className, vertical } = Astro.props;

const sizeClass =
  getColSpans(size ?? {}, 'basis-full w-full') +
  getColStarts(start ?? {}) +
  ` ${getVerticalAlignment(vertical)}`;
---

<figure
  class={`relative overflow-hidden ${sizeClass} ${className ?? ''}`.trim()}
>
  <img
    src={src}
    alt={caption}
    loading="lazy"
    decoding="async"
    class="sensapicture__img"
    onload="this.classList.add('is-loaded')"
  />
  <figcaption class="font-body text-gray-500 text-right text-md mt-2">
    {caption}
  </figcaption>

  <style>
    /* Blur-up placeholder: we start blurred and remove blur once the real image has loaded. */
    .sensapicture__img {
      width: 100%;
      display: block;
      object-fit: cover;
      filter: blur(18px);
      transform: scale(1.03);
      opacity: 0.65;
      transition:
        filter 500ms ease,
        transform 500ms ease,
        opacity 500ms ease;
    }

    .sensapicture__img.is-loaded {
      filter: blur(0);
      transform: scale(1);
      opacity: 1;
    }
  </style>
</figure>
