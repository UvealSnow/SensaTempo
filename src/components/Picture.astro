---
import type { HTMLAttributes } from 'astro/types';
import { pictureDetails, type ResponsiveImage } from '~/utils/images';
import {
  getColSpans,
  getColStarts,
  getVerticalAlignment,
  type FlexSize,
  type FlexStart,
  type VerticalAlign,
} from '~/utils/grid';

interface Props extends Omit<HTMLAttributes<'figure'>, 'class'> {
  // Details overlay: shown on hover or focus (always on touch screens), and the `alt` fallback
  description?: string | null;
  takenAt?: Date | null;
  // Reveal the details when an ancestor `.details-group` is hovered (e.g. a card) instead of the image
  inGroup?: boolean;
  size?: FlexSize;
  start?: FlexStart;
  vertical?: VerticalAlign;
  image?: ResponsiveImage | null;
  src?: string;
  // First image on screen only: no lazy loading or fade, both would delay LCP
  eager?: boolean;
  class?: string;
}

const {
  description,
  takenAt,
  inGroup = false,
  size,
  start,
  vertical,
  image,
  src,
  eager = false,
  class: className,
  ...attrs
} = Astro.props;

const details = pictureDetails(description, takenAt);

const sizeClass =
  getColSpans(size ?? { sm: '12/12' }, 'col-span-12') +
  getColStarts(start ?? {}) +
  ` ${getVerticalAlignment(vertical)}`;
---

<figure
  class={`relative picture ${inGroup ? '' : 'details-group'} ${sizeClass} ${className ?? ''}`.trim()}
  {...attrs}
>
  <div
    class="relative overflow-hidden bg-light-gray/20"
    style={image ? `aspect-ratio: ${image.width} / ${image.height}` : undefined}
  >
    {image && (
      <div
        aria-hidden="true"
        class="absolute inset-0 scale-110 bg-cover bg-center blur-xl"
        style={`background-image: url('${image.placeholder}')`}
      />
    )}
    <img
      src={image?.src ?? src}
      srcset={image?.srcset}
      sizes={image?.sizes}
      width={image?.width}
      height={image?.height}
      alt={image?.alt || description || ''}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      class={`picture__image relative block h-full w-full object-cover ${eager ? '' : 'opacity-0 transition-opacity duration-500 ease-in-out'}`}
      onload={eager ? undefined : "this.classList.remove('opacity-0')"}
    />
  </div>
  {details && (
    <figcaption class="picture__details pointer-events-none absolute inset-0 flex items-end justify-end bg-linear-150 from-transparent from-25% to-black/60 to-75% p-4 md:p-8">
      <span class="picture__details-text font-body text-right text-lg leading-tight text-white">
        {details}
      </span>
    </figcaption>
  )}
</figure>
