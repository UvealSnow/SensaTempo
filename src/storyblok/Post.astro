---
import { storyblokEditable, type SbBlokData } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import Picture from '~/components/Picture.astro';
import FormattedDate from '~/components/layout/FormattedDate.astro';
import { responsiveImage, type StoryblokAsset } from '~/utils/images';
import { parseStoryblokDate, postDate } from '~/utils/posts';

interface Props {
  blok: SbBlokData & {
    title?: string;
    cover?: StoryblokAsset;
    cover_description?: string;
    cover_taken_at?: string;
    published_at?: string;
    // Replaced by `published_at`; read until the field is deleted
    date?: string;
    body?: SbBlokData[];
  };
  publishedAt?: string | null;
}

const { blok, publishedAt } = Astro.props;
const cover = responsiveImage(blok.cover);
const date = postDate(blok.published_at || blok.date, publishedAt);
---

<article
  class="grid grid-cols-12 gap-x-4 gap-y-16 lg:gap-y-24"
  {...storyblokEditable(blok)}
>
  {cover && (
    <Picture
      image={cover}
      description={blok.cover_description}
      takenAt={parseStoryblokDate(blok.cover_taken_at)}
      eager
    />
  )}

  <header class="col-span-12 lg:col-span-10 lg:col-start-2">
    <h1 class="font-display text-dark-gray text-4xl leading-tight md:text-[40px]">
      {blok.title}
    </h1>
    {date && (
      <FormattedDate
        date={date}
        class="font-body text-light-gray mt-2 block text-lg"
      />
    )}
  </header>

  {blok.body?.map((child) => (
    <StoryblokComponent blok={child} />
  ))}
</article>
