---
import { storyblokEditable, type SbBlokData } from '@storyblok/astro';
import Picture from '~/components/Picture.astro';
import FormattedDate from '~/components/layout/FormattedDate.astro';
import { AVAILABLE_LANGUAGES } from '~/consts';
import { responsiveImage } from '~/utils/images';
import { pagePath } from '~/utils/navigation';
import { currentLang } from '~/utils/page';
import { postSummaries } from '~/utils/posts';

interface Props {
  // `posts` arrive as stories when fetched with resolve_relations: 'post_list.posts'
  blok: SbBlokData & { title?: string; posts?: unknown[] };
}

const { blok } = Astro.props;
const lang = currentLang(Astro);
const posts = postSummaries(blok.posts, AVAILABLE_LANGUAGES);
// Cards are 6/12 from md up
const cardSpans = { md: '6/12', lg: '6/12' };
---

<section class="col-span-12" {...storyblokEditable(blok)}>
  {blok.title && (
    <h2 class="font-display text-dark-gray mb-12 text-3xl md:text-[32px]">
      {blok.title}
    </h2>
  )}
  <ul class="grid grid-cols-1 gap-x-4 gap-y-16 md:grid-cols-2">
    {posts.map((post) => (
      <li>
        <a href={pagePath(lang, post.slug)} class="group block">
          <Picture
            image={responsiveImage(post.cover, { spans: cardSpans })}
            class="transition-opacity group-hover:opacity-90"
          />
          <h3 class="font-display text-dark-gray mt-6 text-3xl leading-tight group-hover:underline">
            {post.title}
          </h3>
          {post.date && (
            <FormattedDate
              date={post.date}
              class="font-body text-light-gray mt-2 block text-lg"
            />
          )}
          {post.excerpt && (
            <p class="font-body mt-3 text-xl leading-[26px] text-black">
              {post.excerpt}
            </p>
          )}
        </a>
      </li>
    ))}
  </ul>
</section>
