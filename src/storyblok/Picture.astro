---
import { storyblokEditable, type SbBlokData } from '@storyblok/astro';
import Picture from '~/components/Picture.astro';
import { blokPlacement, type GridBlok } from '~/utils/grid';
import { parseStoryblokDate } from '~/utils/posts';
import {
  responsiveImage,
  type Ratio,
  type StoryblokAsset,
} from '~/utils/images';

interface Props {
  blok: SbBlokData &
    GridBlok & {
      image?: StoryblokAsset;
      description?: string;
      taken_at?: string;
      // Replaced by `description`; read until the field is deleted
      caption?: string;
      ratio?: Ratio;
    };
}

const { blok } = Astro.props;
const placement = blokPlacement(blok);
const image = responsiveImage(blok.image, {
  ratio: blok.ratio || 'golden',
  spans: placement.size,
});
---

{image && (
  <Picture
    image={image}
    description={blok.description || blok.caption}
    takenAt={parseStoryblokDate(blok.taken_at)}
    {...placement}
    {...storyblokEditable(blok)}
  />
)}
