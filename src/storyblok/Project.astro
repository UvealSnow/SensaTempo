---
import { storyblokEditable, type SbBlokData } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import ArticleHeader from '~/components/ArticleHeader.astro';
import type { StoryblokAsset } from '~/utils/images';

interface Props {
  blok: SbBlokData & {
    title?: string;
    cover?: StoryblokAsset;
    cover_description?: string;
    cover_taken_at?: string;
    year?: string;
    body?: SbBlokData[];
  };
}

const { blok } = Astro.props;
---

<article
  class="grid grid-cols-12 gap-x-4 gap-y-16 lg:gap-y-24"
  {...storyblokEditable(blok)}
>
  <ArticleHeader
    title={blok.title}
    cover={blok.cover}
    coverDescription={blok.cover_description}
    coverTakenAt={blok.cover_taken_at}
    meta={blok.year?.trim() || undefined}
  />

  {blok.body?.map((child) => (
    <StoryblokComponent blok={child} />
  ))}
</article>
