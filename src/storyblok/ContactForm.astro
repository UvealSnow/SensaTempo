---
import { storyblokEditable, type SbBlokData } from '@storyblok/astro';
import { contactStrings, turnstileSiteKey } from '~/utils/contact';
import {
  blokPlacement,
  getColSpans,
  getColStarts,
  type GridBlok,
} from '~/utils/grid';
import { currentLang } from '~/utils/page';

interface Props {
  blok: SbBlokData & GridBlok;
}

const { blok } = Astro.props;
const lang = currentLang(Astro);
const strings = contactStrings(blok, lang);
const { size, start } = blokPlacement(blok);
const siteKey = turnstileSiteKey(import.meta.env);

const label = 'font-body text-dark-gray text-lg';
const input =
  'font-body w-full rounded-[4px] border border-line bg-white px-4 py-3 text-lg text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dark-gray aria-[invalid=true]:border-red-700';
---

<section
  class={`${getColSpans(size, 'col-span-12')}${getColStarts(start)}`}
  {...storyblokEditable(blok)}
>
  <form
    class="flex max-w-[640px] flex-col gap-6"
    novalidate
    data-contact-form
    data-lang={lang}
    data-strings={JSON.stringify(strings)}
  >
    <div class="flex flex-col gap-2">
      <label for="contact-name" class={label}>
        {strings.name_label}
      </label>
      <input
        id="contact-name"
        name="name"
        required
        maxlength="100"
        autocomplete="name"
        class={input}
      />
    </div>
    <div class="flex flex-col gap-2">
      <label for="contact-email" class={label}>
        {strings.email_label}
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        required
        maxlength="254"
        autocomplete="email"
        class={input}
      />
    </div>
    <div class="flex flex-col gap-2">
      <label for="contact-message" class={label}>
        {strings.message_label}
      </label>
      <textarea
        id="contact-message"
        name="message"
        required
        maxlength="5000"
        rows="6"
        class={`${input} resize-y`}
      ></textarea>
    </div>

    <!-- Honeypot: hidden from people and assistive tech, filled by bots -->
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label>
        Website <input name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <!-- Only shows a challenge when Cloudflare isn't sure; adds the `token` field -->
    <div
      class="cf-turnstile"
      data-sitekey={siteKey}
      data-language={lang}
      data-appearance="interaction-only"
      data-response-field-name="token"
    ></div>

    <div class="flex flex-wrap items-center gap-4">
      <button
        type="submit"
        class="font-body bg-dark-gray cursor-pointer rounded-full px-8 py-3 text-lg text-white hover:bg-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dark-gray disabled:cursor-wait disabled:opacity-60"
        data-submit
      >
        {strings.submit_label}
      </button>
      <p
        class="font-body text-light-gray text-lg data-[state=error]:text-red-700"
        role="status"
        aria-live="polite"
        data-status
      ></p>
    </div>
    <noscript>
      <p class="font-body text-light-gray text-lg">
        {strings.noscript_message}
      </p>
    </noscript>
  </form>

  <p
    class="font-body text-dark-gray hidden max-w-[640px] text-xl leading-8"
    tabindex="-1"
    data-success
  >
    {strings.success_message}
  </p>
</section>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>

<script>
  import type { ContactStrings } from '~/utils/contact';

  declare global {
    interface Window {
      // eslint-disable-next-line no-unused-vars -- type signature
      turnstile?: { reset: (container?: HTMLElement) => void };
    }
  }

  const ENDPOINT = '/api/contact';
  const FIELDS = ['name', 'email', 'message'];

  for (const form of document.querySelectorAll<HTMLFormElement>(
    '[data-contact-form]'
  )) {
    const strings = JSON.parse(form.dataset.strings ?? '{}') as ContactStrings;
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const success =
      form.parentElement!.querySelector<HTMLElement>('[data-success]')!;
    const field = (name: string) =>
      form.elements.namedItem(name) as
        HTMLInputElement | HTMLTextAreaElement | null;

    const showError = (message: string, invalid: string[] = []) => {
      status.dataset.state = 'error';
      status.textContent = message;
      for (const name of FIELDS) {
        field(name)?.setAttribute(
          'aria-invalid',
          String(invalid.includes(name))
        );
      }
      field(invalid[0] ?? '')?.focus();
    };

    // The widget fills `token` asynchronously, and again after each reset
    const waitForToken = async () => {
      for (let i = 0; i < 40 && !field('token')?.value; i++) {
        await new Promise((resolve) => setTimeout(resolve, 250));
      }
      return Boolean(field('token')?.value);
    };

    form.addEventListener('input', (event) => {
      (event.target as HTMLElement).removeAttribute('aria-invalid');
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const invalid = FIELDS.filter((name) => !field(name)?.checkValidity());
      if (invalid.length) return showError(strings.invalid_message, invalid);

      button.disabled = true;
      button.textContent = strings.sending_label;
      status.dataset.state = '';
      status.textContent = '';

      if (!(await waitForToken())) {
        button.disabled = false;
        button.textContent = strings.submit_label;
        return showError(strings.captcha_message);
      }

      let result: { ok?: boolean; error?: string; fields?: string[] };
      try {
        const response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            ...Object.fromEntries(new FormData(form)),
            lang: form.dataset.lang,
            page: location.pathname,
          }),
        });
        result = await response.json().catch(() => ({}));
        if (!response.ok) result.ok = false;
      } catch {
        result = { error: 'network' };
      }

      button.disabled = false;
      button.textContent = strings.submit_label;

      if (result.ok) {
        form.hidden = true;
        success.classList.remove('hidden');
        success.focus();
        return;
      }
      // A token is single-use: get a fresh one for the next try
      window.turnstile?.reset(
        form.querySelector<HTMLElement>('.cf-turnstile') ?? undefined
      );
      if (result.error === 'invalid')
        showError(strings.invalid_message, result.fields);
      else if (result.error === 'captcha') showError(strings.captcha_message);
      else showError(strings.error_message);
    });
  }
</script>
