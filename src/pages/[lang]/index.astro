---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import Layout from '~/layouts/Layout.astro';

import Picture from '~/components/Picture.astro';

import { AVAILABLE_LANGUAGES } from '~/consts';
import { HOME_SLUG } from '~/utils/navigation';
import { getStoryContent } from '~/utils/stories';

// Static build only; the preview server renders every request
export async function getStaticPaths() {
  return AVAILABLE_LANGUAGES.map((lang) => ({ params: { lang } }));
}

const { lang = '' } = Astro.params;
if (!AVAILABLE_LANGUAGES.includes(lang)) {
  return new Response(null, { status: 404 });
}

const story = await getStoryContent(Astro.locals, lang, HOME_SLUG);
---

<Layout>
  {story ? (
    <StoryblokComponent blok={story} />
  ) : (
    // TODO: drop the placeholders once the `home` story is published
    <div class="grid grid-cols-12 gap-4">
      <Picture
        src="https://placehold.co/600x400"
        caption="Something nice"
        vertical="center"
        size={{ sm: '6/12' }}
      />
      <Picture
        src="https://placehold.co/600x800"
        caption="Another nice photo - 27.03.26"
        size={{ sm: '6/12' }}
      />
    </div>
  )}
</Layout>
