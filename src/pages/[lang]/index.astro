---
import Layout from '~/layouts/Layout.astro';

import Picture from '~/components/Picture.astro';

import { AVAILABLE_LANGUAGES } from '~/consts';

export async function getStaticPaths() {
  return AVAILABLE_LANGUAGES.map((lang) => ({ params: { lang } }));
}

// TODO: render the `home` story for Astro.params.lang instead of the placeholders below
---

<Layout>
  <div class="grid grid-cols-12 gap-4">
    <Picture
      src="https://placehold.co/600x400"
      caption="Something nice"
      vertical="center"
      size={{ sm: '6/12' }}
    />
    <Picture
      src="https://placehold.co/600x800"
      caption="Another nice photo - 27.03.26"
      size={{ sm: '6/12' }}
    />
  </div>
</Layout>
