---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import Layout from '~/layouts/Layout.astro';

import Picture from '~/components/Picture.astro';

import { AVAILABLE_LANGUAGES, SITE_TITLE } from '~/consts';
import { hasHeadingOne } from '~/utils/headings';
import { HOME_SLUG } from '~/utils/navigation';
import { getStoryContent } from '~/utils/stories';

// Static build only; the preview server renders every request
export async function getStaticPaths() {
  return AVAILABLE_LANGUAGES.map((lang) => ({ params: { lang } }));
}

const { lang = '' } = Astro.params;
if (!AVAILABLE_LANGUAGES.includes(lang)) {
  // Only reached on the preview server (every static path exists); status 404
  return Astro.rewrite('/404');
}

const story = await getStoryContent(Astro.locals, lang, HOME_SLUG);
---

<Layout>
  <!-- The home page shows photos only; screen readers still get a page heading -->
  {!hasHeadingOne(story) && <h1 class="sr-only">{SITE_TITLE}</h1>}
  {story ? (
    <StoryblokComponent blok={story} />
  ) : (
    // TODO: drop the placeholders once the `home` story is published
    <div class="grid grid-cols-12 gap-4">
      <Picture
        src="https://placehold.co/600x400"
        description="Something nice"
        vertical="center"
        size={{ sm: '6/12' }}
      />
      <Picture
        src="https://placehold.co/600x800"
        description="Another nice photo"
        takenAt={new Date(Date.UTC(2026, 2, 27))}
        size={{ sm: '6/12' }}
      />
    </div>
  )}
</Layout>
