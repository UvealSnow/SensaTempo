---
import { getCollection } from 'astro:content';
import BlogIndex from '~/components/blog/BlogIndex.astro';
import { AVAILABLE_LANGUAGES } from '~/consts';
import Layout from '~/layouts/Layout.astro';
import { paginate, parsePage, postsByAuthor } from '~/utils/blog';
import type { StoryblokAsset } from '~/utils/images';
import { AUTHORS_FOLDER } from '~/utils/posts';
import { getBlog, getRefStory } from '~/utils/stories';

// Static build only; the preview server renders every request
export async function getStaticPaths() {
  const authors = await getCollection('authors');
  const paths = [];
  for (const lang of AVAILABLE_LANGUAGES) {
    const { posts } = await getBlog(undefined, lang);
    for (const { data } of authors.filter(
      (entry) => entry.data.lang === lang
    )) {
      const author = data.slug.slice(AUTHORS_FOLDER.length + 1);
      const { totalPages } = paginate(postsByAuthor(posts, data.uuid), 1)!;
      paths.push({ params: { lang, author, page: undefined } });
      for (let page = 1; page <= totalPages; page++) {
        paths.push({ params: { lang, author, page: String(page) } });
      }
    }
  }
  return paths;
}

const { lang = '', author: slug = '' } = Astro.params;
const pageNumber = parsePage(Astro.params.page);
const valid = AVAILABLE_LANGUAGES.includes(lang) && pageNumber !== null;
const [author, blog] = valid
  ? await Promise.all([
      getRefStory(Astro.locals, lang, 'author', slug),
      getBlog(Astro.locals, lang),
    ])
  : [null, null];
const feed =
  author && blog
    ? paginate(postsByAuthor(blog.posts, author.uuid), pageNumber!)
    : null;

if (!author || !blog || !feed) {
  // Only reached on the preview server (every static path exists); status 404
  return Astro.rewrite('/404');
}

const { content } = author;
const { strings } = blog;
const name = (content.name as string | undefined) || slug;
const bio = (content.bio as string | undefined) || undefined;
const basePath = `/${lang}/${AUTHORS_FOLDER}/${slug}/`;
const title =
  feed.page > 1 ? `${name} – ${strings.page_label} ${feed.page}` : name;
---

<Layout
  title={title}
  description={bio}
  image={content.photo as StoryblokAsset | undefined}
  canonical={Astro.params.page === '1' ? basePath : undefined}
>
  <BlogIndex
    title={name}
    description={bio}
    posts={feed.items}
    page={feed.page}
    totalPages={feed.totalPages}
    basePath={basePath}
    lang={lang}
    blog={blog}
    photo={content.photo as StoryblokAsset | undefined}
    socials={content.socials as { icon?: string; url?: string }[] | undefined}
    blok={content}
  />
</Layout>
