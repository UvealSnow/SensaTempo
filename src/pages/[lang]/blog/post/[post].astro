---
import { getCollection } from 'astro:content';
import { AVAILABLE_LANGUAGES } from '~/consts';
import Layout from '~/layouts/Layout.astro';
import Post from '~/storyblok/Post.astro';
import { AUTHORS_FOLDER, postDate, postSlug } from '~/utils/posts';
import { entrySeo } from '~/utils/seo';
import { getAuthors, getPost } from '~/utils/stories';

// Static build only; the preview server renders every request
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.flatMap(({ data }) => {
    const post = postSlug(data.slug, AVAILABLE_LANGUAGES);
    return post ? [{ params: { lang: data.lang, post } }] : [];
  });
}

const { lang = '', post: slug = '' } = Astro.params;
const post = AVAILABLE_LANGUAGES.includes(lang)
  ? await getPost(Astro.locals, lang, slug)
  : null;

if (!post) {
  // Only reached on the preview server (every static path exists); status 404
  return Astro.rewrite('/404');
}

const { content, publishedAt } = post;
const seo = entrySeo(content);
const author = (await getAuthors(lang)).find(
  ({ uuid }) => uuid === content.author
);
---

<Layout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  noindex={seo.noindex}
  type="article"
  schemaType="BlogPosting"
  author={
    author && {
      name: author.name,
      url: new URL(`/${lang}/${AUTHORS_FOLDER}/${author.slug}/`, Astro.site)
        .href,
    }
  }
  publishedTime={postDate(
    (content.published_at || content.date) as string | undefined,
    publishedAt
  )}
>
  <Post blok={content} publishedAt={publishedAt} />
</Layout>
