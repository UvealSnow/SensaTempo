---
import { getCollection } from 'astro:content';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import { AVAILABLE_LANGUAGES } from '~/consts';
import Layout from '~/layouts/Layout.astro';
import { HOME_SLUG } from '~/utils/navigation';
import { getStoryContent } from '~/utils/stories';

// Static build only; the preview server renders every request
export async function getStaticPaths() {
  const allPages = await getCollection('pages');
  const paths = [];

  for (let i = 0; i < AVAILABLE_LANGUAGES.length; i++) {
    const lang = AVAILABLE_LANGUAGES[i];
    const pagesInLanguage = allPages.filter((page) => page.data.lang === lang);
    const pathsInLanguages = pagesInLanguage
      .filter((page) => page.data.slug !== HOME_SLUG)
      .map((page) => ({ params: { lang, slug: page.data.slug } }));

    paths.push(...pathsInLanguages);
  }

  return paths;
}

const { lang = '', slug = '' } = Astro.params;
const story = AVAILABLE_LANGUAGES.includes(lang)
  ? await getStoryContent(Astro.locals, lang, slug)
  : null;

if (!story) {
  return new Response(null, { status: 404 });
}
---

<Layout lang={lang} slug={slug}>
  <StoryblokComponent blok={story} />
</Layout>
