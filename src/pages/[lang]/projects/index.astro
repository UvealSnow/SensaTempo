---
import { storyblokEditable } from '@storyblok/astro';
import ProjectCard from '~/components/projects/ProjectCard.astro';
import { AVAILABLE_LANGUAGES } from '~/consts';
import Layout from '~/layouts/Layout.astro';
import { entrySeo } from '~/utils/seo';
import { getProjectsIndex } from '~/utils/stories';

// Static build only; the preview server renders every request
export function getStaticPaths() {
  return AVAILABLE_LANGUAGES.map((lang) => ({ params: { lang } }));
}

const { lang = '' } = Astro.params;
const index = AVAILABLE_LANGUAGES.includes(lang)
  ? await getProjectsIndex(Astro.locals, lang)
  : null;

if (!index) {
  // Only reached on the preview server (every static path exists); status 404
  return Astro.rewrite('/404');
}

const { blok, strings, projects } = index;
const seo = entrySeo(blok);
---

<Layout
  title={seo.title ?? strings.title}
  description={seo.description}
  image={seo.image}
  noindex={seo.noindex}
  schemaType="CollectionPage"
>
  <div class="flex flex-col gap-16 lg:gap-20">
    <header
      class="flex flex-col gap-6"
      {...(blok ? storyblokEditable(blok) : {})}
    >
      <h1 class="font-display text-dark-gray text-4xl leading-tight md:text-[40px]">
        {strings.title}
      </h1>
      {strings.description && (
        <p class="font-body text-light-gray max-w-[600px] text-xl leading-8">
          {strings.description}
        </p>
      )}
    </header>

    {projects.length === 0 ? (
      <p class="font-body text-light-gray text-xl">{strings.empty_label}</p>
    ) : (
      <ul class="grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-8 lg:gap-12">
        {projects.map((project, i) => (
          <li>
            <ProjectCard project={project} strings={strings} eager={i < 2} />
          </li>
        ))}
      </ul>
    )}
  </div>
</Layout>
