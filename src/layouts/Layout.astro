---
import NavBar from '~/components/layout/NavBar.astro';
import Footer from '~/components/layout/Footer.astro';

import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.svg" />
  </head>

  <body class="bg-off-white min-h-screen flex flex-col">
    <NavBar />

    <main class="pb-8 px-4 container mx-auto">
      <slot />
    </main>

    <Footer />
  </body>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const actionButton = document.querySelector('[data-navbar-toggle]');
      const links = document.querySelector('[data-navbar-links]');
      const openIcon = document.querySelector('[data-navbar-icon-open]');
      const closeIcon = document.querySelector('[data-navbar-icon-close]');

      if (!actionButton || !links || !openIcon || !closeIcon) return;

      actionButton.addEventListener('click', () => {
        openIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
        links.classList.toggle('hidden');

        const expanded = actionButton.getAttribute('aria-expanded') === 'true';
        actionButton.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      });
    });
  </script>
</html>
