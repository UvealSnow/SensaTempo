---
import Analytics from '~/components/layout/Analytics.astro';
import NavBar from '~/components/layout/NavBar.astro';
import Footer from '~/components/layout/Footer.astro';
import BaseHead from '~/components/layout/BaseHead.astro';

import { AVAILABLE_LANGUAGES, X_DEFAULT_LANGUAGE } from '~/consts';
import { pagePath } from '~/utils/navigation';
import { currentLang, currentSlug } from '~/utils/page';
import { FOOTER, getLayoutStory, NAVBAR } from '~/utils/stories';
import { uiStrings } from '~/utils/ui';

import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
}

const lang = currentLang(Astro);
const slug = currentSlug(Astro);
const strings = uiStrings(lang);
const [navbar, footer] = await Promise.all([
  getLayoutStory(Astro.locals, lang, NAVBAR),
  getLayoutStory(Astro.locals, lang, FOOTER),
]);
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.svg" />
    <BaseHead {...Astro.props} />
    <noscript>
      <style>
        .picture__image {
          opacity: 1 !important;
        }
      </style>
    </noscript>
    {AVAILABLE_LANGUAGES.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate}
        href={new URL(pagePath(alternate, slug), Astro.site)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(pagePath(X_DEFAULT_LANGUAGE, slug), Astro.site)}
    />
    <Analytics />
  </head>

  <body class="bg-off-white min-h-screen flex flex-col">
    <a
      href="#main"
      class="font-body bg-dark-gray sr-only z-[60] rounded-sm px-4 py-2 text-lg text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      {strings.skip_link}
    </a>
    <NavBar blok={navbar} />

    <main
      id="main"
      tabindex="-1"
      class="pb-8 px-4 container mx-auto outline-none md:px-8 xl:px-0"
    >
      <slot />
    </main>

    <Footer blok={footer} />
  </body>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const actionButton = document.querySelector<HTMLButtonElement>(
        '[data-navbar-toggle]'
      );
      const links = document.querySelector<HTMLElement>('[data-navbar-links]');
      const openIcon = document.querySelector<HTMLElement>(
        '[data-navbar-icon-open]'
      );
      const closeIcon = document.querySelector<HTMLElement>(
        '[data-navbar-icon-close]'
      );
      // The open menu covers the page, so everything behind it leaves the tab order
      const behind = document.querySelectorAll<HTMLElement>('main, footer');

      if (!actionButton || !links || !openIcon || !closeIcon) return;

      const isOpen = () =>
        actionButton.getAttribute('aria-expanded') === 'true';
      const setMenuState = (open: boolean) => {
        openIcon.classList.toggle('hidden', open);
        closeIcon.classList.toggle('hidden', !open);
        links.classList.toggle('hidden', !open);
        links.classList.toggle('flex', open);
        actionButton.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.classList.toggle('overflow-hidden', open);
        behind.forEach((element) => (element.inert = open));
      };

      actionButton.addEventListener('click', () => {
        setMenuState(!isOpen());
        if (isOpen()) links.querySelector<HTMLElement>('a')?.focus();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !isOpen()) return;
        setMenuState(false);
        actionButton.focus();
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768 && isOpen()) setMenuState(false);
      });
    });
  </script>
</html>
