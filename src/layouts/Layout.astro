---
import Analytics from '~/components/layout/Analytics.astro';
import NavBar from '~/components/layout/NavBar.astro';
import Footer from '~/components/layout/Footer.astro';
import Seo, { type SeoProps } from '~/components/Seo.astro';

import { currentLang } from '~/utils/page';
import { FOOTER, getLayoutStory, NAVBAR } from '~/utils/stories';
import { uiStrings } from '~/utils/ui';

import '../styles/global.css';

type Props = SeoProps;

const lang = currentLang(Astro);
const strings = uiStrings(lang);
const [navbar, footer] = await Promise.all([
  getLayoutStory(Astro.locals, lang, NAVBAR),
  getLayoutStory(Astro.locals, lang, FOOTER),
]);
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo {...Astro.props} />
    <noscript>
      <style>
        .picture__image {
          opacity: 1 !important;
        }
      </style>
    </noscript>
    <Analytics />
  </head>

  <body class="site bg-page">
    <a
      href="#main"
      class="font-body bg-accent sr-only z-[60] rounded-sm px-4 py-2 text-lg text-on-accent focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      {strings.skip_link}
    </a>
    <NavBar blok={navbar} />

    <main id="main" tabindex="-1" class="site-main">
      <slot />
    </main>

    <Footer blok={footer} />
  </body>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const actionButton = document.querySelector<HTMLButtonElement>(
        '[data-navbar-toggle]'
      );
      const links = document.querySelector<HTMLElement>('[data-navbar-links]');
      // The open menu covers the page, so everything behind it leaves the tab order
      const behind = document.querySelectorAll<HTMLElement>('main, footer');

      if (!actionButton || !links) return;

      const isOpen = () =>
        actionButton.getAttribute('aria-expanded') === 'true';
      const setMenuState = (open: boolean) => {
        // The theme shows the menu and icons from aria-expanded
        actionButton.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.classList.toggle('overflow-hidden', open);
        behind.forEach((element) => (element.inert = open));
      };

      actionButton.addEventListener('click', () => {
        setMenuState(!isOpen());
        if (isOpen()) links.querySelector<HTMLElement>('a')?.focus();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !isOpen()) return;
        setMenuState(false);
        actionButton.focus();
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768 && isOpen()) setMenuState(false);
      });
    });
  </script>
</html>
