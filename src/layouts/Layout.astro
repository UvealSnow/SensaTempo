---
import Analytics from '~/components/layout/Analytics.astro';
import NavBar from '~/components/layout/NavBar.astro';
import Footer from '~/components/layout/Footer.astro';

import { AVAILABLE_LANGUAGES } from '~/consts';
import { pagePath } from '~/utils/navigation';
import { currentLang, currentSlug } from '~/utils/page';
import { FOOTER, getLayoutStory, NAVBAR } from '~/utils/stories';

import '../styles/global.css';

// Crawlers and browsers whose language isn't listed get English
const X_DEFAULT_LANGUAGE = 'en';

const lang = currentLang(Astro);
const slug = currentSlug(Astro);
const [navbar, footer] = await Promise.all([
  getLayoutStory(Astro.locals, lang, NAVBAR),
  getLayoutStory(Astro.locals, lang, FOOTER),
]);
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.svg" />
    {AVAILABLE_LANGUAGES.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate}
        href={new URL(pagePath(alternate, slug), Astro.site)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(pagePath(X_DEFAULT_LANGUAGE, slug), Astro.site)}
    />
    <Analytics />
  </head>

  <body class="bg-off-white min-h-screen flex flex-col">
    <NavBar blok={navbar} />

    <main class="pb-8 px-4 container mx-auto md:px-8 xl:px-0">
      <slot />
    </main>

    <Footer blok={footer} />
  </body>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const actionButton = document.querySelector<HTMLButtonElement>(
        '[data-navbar-toggle]'
      );
      const links = document.querySelector<HTMLElement>('[data-navbar-links]');
      const openIcon = document.querySelector<HTMLElement>(
        '[data-navbar-icon-open]'
      );
      const closeIcon = document.querySelector<HTMLElement>(
        '[data-navbar-icon-close]'
      );

      if (!actionButton || !links || !openIcon || !closeIcon) return;

      const setMenuState = (isOpen: boolean) => {
        openIcon.classList.toggle('hidden', isOpen);
        closeIcon.classList.toggle('hidden', !isOpen);
        links.classList.toggle('hidden', !isOpen);
        links.classList.toggle('flex', isOpen);
        actionButton.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        document.body.classList.toggle('overflow-hidden', isOpen);
      };

      actionButton.addEventListener('click', () => {
        const isExpanded =
          actionButton.getAttribute('aria-expanded') === 'true';
        setMenuState(!isExpanded);
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) setMenuState(false);
      });
    });
  </script>
</html>
